# Environment for the production deployment — Hetzner, via Coolify/Nixpacks
# (see nixpacks.toml). Copy to prod.env, fill in the values, and set the same
# names in the hosting panel. prod.env itself is gitignored; this file carries
# the names and the reasoning, never a value.
#
# Only ADMIN_SESSION_SECRET is genuinely required. Everything else has a
# working fallback in code — the file below says which, so an empty line here
# is a decision and not an oversight.

# ---- Backoffice access (middleware.js, lib/admin/) ----
#
# Two variables with two different jobs. The client sets her own password in
# the backoffice (/admin/passwort), so the password actually in use is NOT
# here: it lives as a salted hash in data/admin/credentials.json, and nobody —
# including us — can read it back.
#
# THIS REQUIRES A PERSISTENT VOLUME on data/ in Coolify. Without one that file
# disappears with the next deploy, the client's password with it, and the
# handover password below silently becomes valid again. It is the single most
# important line in this file.

# The key the session cookie is signed with. Required. Nobody ever types it and
# it never needs to change — a long random string:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# The middleware reads this as "the backoffice is configured": without it (and
# without ADMIN_PASSWORD as a fallback) production answers every /admin and
# /api/admin request with 503 rather than standing open. Read at RUNTIME, so a
# change in the panel takes effect after a container restart, no rebuild.
ADMIN_SESSION_SECRET=

# The HANDOVER password — valid exactly until the client sets her own.
#
# Set it, hand it over once, let her replace it under /admin/passwort. From
# that moment it signs nobody in any more and this line can be emptied: the
# deployment stays configured through ADMIN_SESSION_SECRET above. That is the
# point — afterwards nobody outside the house holds a working credential.
#
# It is also the reset path. A forgotten password cannot be looked up: delete
# data/admin/credentials.json, put a value here again, hand over a new
# starting password.
ADMIN_PASSWORD=

# The user name on the login form. Defaults to "maria" when unset.
ADMIN_USER=

# ---- Who else may sign in (lib/admin/users.js) ----
#
# Everyday access is per person and by e-mail link: the owner adds colleagues
# under /admin/benutzer, they receive a link, and nobody shares a password.
# That list lives in data/admin/users.json — on the persistent volume, with
# the credential file.
#
# THIS VARIABLE IS THE WAY IN BEFORE THAT LIST EXISTS, and the way back in if
# the volume is ever lost. Comma-separated, each entry "address" or
# "address:role" with role one of owner / editor / viewer (default: editor):
#
#   ADMIN_ALLOWLIST=maria@maria-maria.de:owner, jan@agentur.de:editor
#
# Entries here are read-only in the backoffice — the panel owns them, so the
# UI shows them greyed with a note rather than pretending to delete something
# that would reappear on the next request. Seat the first owner here, then
# manage everyone else in /admin/benutzer.
#
#   owner   everything, including access and the password of the house
#   editor  every save the backoffice offers, but not who may sign in
#   viewer  reads only — every write is refused at the middleware
ADMIN_ALLOWLIST=

# Sender for sign-in links and invitations. Falls back to CONTACT_FROM_EMAIL,
# then to the authenticated SMTP mailbox. The links themselves go out over the
# channels configured under "Contact form" below — Resend or SMTP, whichever
# is set. There is deliberately NO webhook channel for them: an inquiry may be
# posted into a Slack hook, a sign-in link may not.
#
# With neither channel configured the backoffice still works, but links only
# reach the server log: the owner's password stays the way in, and
# /admin/benutzer says so at the top of the page.
ADMIN_MAIL_FROM=

# ---- Address of the site (lib/site.js) ----

# Every canonical URL, hreflang entry, sitemap line and JSON-LD @id comes from
# this one value. Falls back to https://www.maria-maria.de. Check it before a
# production deploy — pointing it at the wrong domain is the single most
# expensive mistake in technical SEO.
NEXT_PUBLIC_SITE_URL=

# ---- Indexing (lib/site.js, next.config.js) ----

# "1" on preview/staging instances: adds noindex, nofollow, noarchive to every
# response, including images and sitemap.xml. Leave EMPTY in production.
NEXT_PUBLIC_NOINDEX=

# Search Console / Bing Webmaster verification tokens, rendered as meta tags.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---- Contact form (app/api/contact/route.js) ----
#
# Three delivery routes, tried in this order: webhook, Resend, SMTP. Configure
# ONE of them. With none configured the form still accepts and logs the
# message, but nothing leaves the server.

CONTACT_WEBHOOK_URL=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Recipient and sender. Both fall back to the address in lib/agency.js.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ---- Partner-Shop-Abgleich (lib/shop/) ----
#
# Der Kaufweg jedes Weins führt zu Terra Vera; verlinkt wird über den
# Produkt-Handle (…/products/<handle>). Benennt Terra Vera ein Produkt um,
# antwortet der Link mit 404 — und niemand merkt es, solange nichts nachfragt.
# Genau das tut der Abgleich: er liest die öffentliche Produktseite
# (…/products/<handle>.js — kein Schlüssel nötig) und schreibt Preis,
# Verfügbarkeit und den 404-Fall ins Backoffice.
#
# ACHTUNG, dieselbe Bedingung wie beim Passwort: die gepflegten Handles liegen
# unter data/shop/state.json. OHNE PERSISTENTES VOLUME auf data/ ist eine
# Handle-Korrektur nach dem nächsten Deploy wieder weg, und die Weinseite
# verlinkt still auf die tote Adresse.

# Der nächtliche Lauf im Serverprozess (lib/shop/scheduler.js), 03:17 Ortszeit.
# Leer = an in Produktion, aus in der Entwicklung. "0" schaltet ihn ab — etwa
# wenn der Lauf stattdessen von außen angestoßen wird (siehe CRON_SECRET).
SHOP_SYNC_CRON=

# Schlüssel für /api/cron/shop-sync — die Tür für einen Scheduler von außen
# (Coolify Scheduled Task, systemd-Timer, Uptime-Monitor):
#
#   curl -H "Authorization: Bearer $CRON_SECRET" https://…/api/cron/shop-sync
#
# Diese Route liegt bewusst NICHT hinter der Anmeldung: Ein Cron-Job hat keinen
# Browser, in dem er sich anmelden könnte. Ohne gesetzten Wert antwortet sie in
# Produktion mit 503 (in der Entwicklung bleibt sie offen, dort ist sie nur
# über localhost erreichbar). Wer den nächtlichen Timer oben laufen lässt,
# braucht diese Variable nicht.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
